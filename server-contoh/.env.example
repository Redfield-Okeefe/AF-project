# B.N.R Academy — autentikasi PostgreSQL fase 1 (development lokal).
# Jangan timpa .env lokal yang sudah bekerja; file ini hanya template.
PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://GANTI_USER:GANTI_PASSWORD@127.0.0.1:5432/bnr_academy
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK
# Fase 3A: default disabled. Untuk uji lokal dengan Mailpit: MAIL_MODE=mailpit.
MAIL_MODE=disabled

# Optional: Resend staging testing, only the actual Resend account email.
# MAIL_MODE=resend
# RESEND_API_KEY=re_GANTI
# RESEND_TEST_RECIPIENT=GANTI_EMAIL_AKUN_RESEND

# Local default; cloud mode uses signed REST requests (no browser upload preset).
# MEDIA_MODE=cloudinary
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=bnr-academy/staging
