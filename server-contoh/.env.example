PORT=3001
# Alamat front-end (untuk CORS)
FRONTEND_URL=http://localhost:5173,https://redfield-okeefe.github.io
# Akun Gmail PENGIRIM. Wajib pakai "App Password" (bukan password Gmail biasa):
# Akun Google > Keamanan > aktifkan Verifikasi 2 Langkah > Sandi aplikasi
GMAIL_USER=emailakademi@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Isi dengan teks acak panjang
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
# Email yang otomatis menjadi admin (pisahkan dengan koma)
ADMIN_EMAILS=emailakademi@gmail.com

# PostgreSQL lokal: sesuaikan password dan nama database (jangan commit file .env!)
# Jika password mengandung @ atau #, lakukan URL-encoding agar URL valid.
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@127.0.0.1:5432/bnr_academy
